{
  "$defs": {
    "LifecycleAction": {
      "enum": [
        "submit",
        "approve",
        "reject",
        "deprecate",
        "retire"
      ],
      "title": "LifecycleAction",
      "type": "string"
    }
  },
  "$id": "https://github.com/kogunlowo123/agent-control-plane/schemas/transition.request.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "action": {
      "$ref": "#/$defs/LifecycleAction"
    },
    "comment": {
      "default": "",
      "maxLength": 1000,
      "title": "Comment",
      "type": "string"
    }
  },
  "required": [
    "action"
  ],
  "title": "Transition",
  "type": "object"
}
