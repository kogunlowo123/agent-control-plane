{
  "$defs": {
    "DeploymentStatus": {
      "properties": {
        "corrected": {
          "default": false,
          "title": "Corrected",
          "type": "boolean"
        },
        "desired_replicas": {
          "default": 0,
          "title": "Desired Replicas",
          "type": "integer"
        },
        "drift": {
          "default": [],
          "items": {
            "$ref": "#/$defs/DriftItem"
          },
          "title": "Drift",
          "type": "array"
        },
        "killed_by": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Killed By",
          "type": "array"
        },
        "message": {
          "default": "",
          "title": "Message",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "observed_generation": {
          "default": 0,
          "title": "Observed Generation",
          "type": "integer"
        },
        "phase": {
          "$ref": "#/$defs/Phase"
        },
        "ready_replicas": {
          "default": 0,
          "title": "Ready Replicas",
          "type": "integer"
        },
        "reconciled_at": {
          "format": "date-time",
          "title": "Reconciled At",
          "type": "string"
        },
        "spec_hash": {
          "default": "",
          "title": "Spec Hash",
          "type": "string"
        }
      },
      "required": [
        "name",
        "phase",
        "reconciled_at"
      ],
      "title": "DeploymentStatus",
      "type": "object"
    },
    "DriftItem": {
      "properties": {
        "actual": {
          "default": null,
          "title": "Actual"
        },
        "change": {
          "description": "missing | changed | unexpected | absent",
          "title": "Change",
          "type": "string"
        },
        "expected": {
          "default": null,
          "title": "Expected"
        },
        "kind": {
          "title": "Kind",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "path": {
          "title": "Path",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "name",
        "path",
        "change"
      ],
      "title": "DriftItem",
      "type": "object"
    },
    "KillScope": {
      "enum": [
        "global",
        "agent",
        "deployment"
      ],
      "title": "KillScope",
      "type": "string"
    },
    "KillSwitch": {
      "description": "An emergency stop. While active, matching deployments run zero replicas with\ndeny-all network policy, and their identities are suspended in the identity fabric.",
      "properties": {
        "active": {
          "default": true,
          "title": "Active",
          "type": "boolean"
        },
        "engaged_at": {
          "format": "date-time",
          "title": "Engaged At",
          "type": "string"
        },
        "engaged_by": {
          "title": "Engaged By",
          "type": "string"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        },
        "release_reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Release Reason"
        },
        "released_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Released At"
        },
        "released_by": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Released By"
        },
        "scope": {
          "$ref": "#/$defs/KillScope"
        },
        "target": {
          "description": "'*' for global, namespace/name for agent, name for deployment",
          "title": "Target",
          "type": "string"
        }
      },
      "required": [
        "id",
        "scope",
        "target",
        "reason",
        "engaged_by",
        "engaged_at"
      ],
      "title": "KillSwitch",
      "type": "object"
    },
    "Phase": {
      "enum": [
        "PendingApproval",
        "Progressing",
        "Available",
        "Killed",
        "Degraded",
        "Deleted"
      ],
      "title": "Phase",
      "type": "string"
    }
  },
  "$id": "https://github.com/kogunlowo123/agent-control-plane/schemas/kill-switch.response.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "affected": {
      "items": {
        "type": "string"
      },
      "title": "Affected",
      "type": "array"
    },
    "identity_actions": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Identity Actions",
      "type": "object"
    },
    "kill_switch": {
      "$ref": "#/$defs/KillSwitch"
    },
    "statuses": {
      "default": [],
      "items": {
        "$ref": "#/$defs/DeploymentStatus"
      },
      "title": "Statuses",
      "type": "array"
    }
  },
  "required": [
    "kill_switch",
    "affected"
  ],
  "title": "KillSwitchResult",
  "type": "object"
}
