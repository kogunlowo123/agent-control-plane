{
  "$defs": {
    "EgressRule": {
      "additionalProperties": false,
      "properties": {
        "cidr": {
          "description": "Destination network, e.g. 10.20.0.0/16",
          "title": "Cidr",
          "type": "string"
        },
        "ports": {
          "items": {
            "type": "integer"
          },
          "maxItems": 16,
          "minItems": 1,
          "title": "Ports",
          "type": "array"
        },
        "protocol": {
          "default": "TCP",
          "pattern": "^(TCP|UDP)$",
          "title": "Protocol",
          "type": "string"
        }
      },
      "required": [
        "cidr",
        "ports"
      ],
      "title": "EgressRule",
      "type": "object"
    },
    "Framework": {
      "description": "Agent frameworks with a platform run-contract adapter (agent_control_plane.adapters).",
      "enum": [
        "langgraph",
        "crewai",
        "autogen",
        "google_adk",
        "microsoft_agent_framework",
        "aws_strands"
      ],
      "title": "Framework",
      "type": "string"
    },
    "ImageRef": {
      "additionalProperties": false,
      "properties": {
        "digest": {
          "description": "Pinned sha256 digest; tags are not accepted",
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Digest",
          "type": "string"
        },
        "repository": {
          "maxLength": 255,
          "minLength": 3,
          "pattern": "^[a-z0-9]+([._\\-/:][a-z0-9]+)*$",
          "title": "Repository",
          "type": "string"
        }
      },
      "required": [
        "repository",
        "digest"
      ],
      "title": "ImageRef",
      "type": "object"
    },
    "Resources": {
      "additionalProperties": false,
      "properties": {
        "cpu_limit": {
          "default": "1",
          "pattern": "^([1-9]\\d{0,4}m|\\d{1,3}(\\.\\d{1,3})?)$",
          "title": "Cpu Limit",
          "type": "string"
        },
        "cpu_request": {
          "default": "250m",
          "pattern": "^([1-9]\\d{0,4}m|\\d{1,3}(\\.\\d{1,3})?)$",
          "title": "Cpu Request",
          "type": "string"
        },
        "memory_limit": {
          "default": "512Mi",
          "pattern": "^[1-9]\\d{0,5}(Ki|Mi|Gi)$",
          "title": "Memory Limit",
          "type": "string"
        },
        "memory_request": {
          "default": "256Mi",
          "pattern": "^[1-9]\\d{0,5}(Ki|Mi|Gi)$",
          "title": "Memory Request",
          "type": "string"
        }
      },
      "title": "Resources",
      "type": "object"
    },
    "ToolRef": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "pattern": "^[a-z][a-z0-9_.\\-]{1,63}$",
          "title": "Name",
          "type": "string"
        },
        "version": {
          "maxLength": 23,
          "minLength": 5,
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "name",
        "version"
      ],
      "title": "ToolRef",
      "type": "object"
    }
  },
  "$id": "https://github.com/kogunlowo123/agent-control-plane/schemas/create-agent-version.request.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "egress": {
      "default": [],
      "items": {
        "$ref": "#/$defs/EgressRule"
      },
      "maxItems": 20,
      "title": "Egress",
      "type": "array"
    },
    "entrypoint": {
      "pattern": "^[A-Za-z_][A-Za-z0-9_.]*:[A-Za-z_][A-Za-z0-9_]*$",
      "title": "Entrypoint",
      "type": "string"
    },
    "framework": {
      "$ref": "#/$defs/Framework"
    },
    "health_path": {
      "anyOf": [
        {
          "pattern": "^/[A-Za-z0-9/_\\-.]{0,100}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Health Path"
    },
    "image": {
      "$ref": "#/$defs/ImageRef"
    },
    "release_notes": {
      "default": "",
      "maxLength": 4000,
      "title": "Release Notes",
      "type": "string"
    },
    "resources": {
      "$ref": "#/$defs/Resources",
      "default": {
        "cpu_limit": "1",
        "cpu_request": "250m",
        "memory_limit": "512Mi",
        "memory_request": "256Mi"
      }
    },
    "scopes": {
      "items": {
        "maxLength": 200,
        "type": "string"
      },
      "maxItems": 50,
      "minItems": 1,
      "title": "Scopes",
      "type": "array",
      "uniqueItems": true
    },
    "tools": {
      "default": [],
      "items": {
        "$ref": "#/$defs/ToolRef"
      },
      "maxItems": 50,
      "title": "Tools",
      "type": "array"
    },
    "version": {
      "maxLength": 23,
      "minLength": 5,
      "title": "Version",
      "type": "string"
    }
  },
  "required": [
    "version",
    "framework",
    "entrypoint",
    "image",
    "scopes"
  ],
  "title": "CreateAgentVersion",
  "type": "object"
}
